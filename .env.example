# Скопируй в .env (cp .env.example .env), заполни и закрой доступ: chmod 600 .env
# Секреты генерируй так: openssl rand -hex 32  (в hex нет символов, ломающих строку подключения)
# .env в git не попадает (.gitignore) и в образ не копируется (.dockerignore).

# Домен, на который Caddy выпустит сертификат: <поддомен>.duckdns.org (локально: localhost)
DOMAIN=
# Пароль Postgres; применяется только при первом создании тома pgdata
POSTGRES_PASSWORD=
# Токен для iOS-Команды (Authorization: Bearer ...), не короче 32 символов
Bot__IngestToken=
# Токен бота от @BotFather
Bot__TelegramToken=
# Твой chat id в Telegram (узнать через @userinfobot)
Bot__OwnerChatId=

# Бэкап (docs/deploy.md, раздел про бэкапы). Ключ B2 только Write Only; приватный ключ age сюда не класть никогда
# Публичный ключ age (age1...), не секрет
BACKUP_AGE_RECIPIENT=
# Имя приватного бакета Backblaze B2
B2_BUCKET=
# Ключ B2 vm-backup (Write Only, один бакет): keyID и applicationKey
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
